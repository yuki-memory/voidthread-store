Options -Indexes

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://code.jquery.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; connect-src 'none'; upgrade-insecure-requests"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>

<FilesMatch "(^\.env|\.sqlite$|\.sqlite3$|\.db$|\.sql$|composer\.(json|lock)$|package(-lock)?\.json$)">
  Require all denied
</FilesMatch>

<FilesMatch "\.(mp3|wav|flac|m4a|ogg|zip)$">
  Header always set X-Content-Type-Options "nosniff"
  Header always set Content-Disposition "attachment"
</FilesMatch>
